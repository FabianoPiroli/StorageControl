@{
    ViewData["Title"] = "Dashboard";
}

<div class="text-center mb-5 mt-4">
    <h1 class="display-4 fw-bold text-primary">Controle de Estoque</h1>
    <p class="lead">Visão geral do sistema de gerenciamento de estoque.</p>
</div>

<div class="row g-4">
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-primary text-white h-100">
            <div class="card-body text-center">
                <h5 class="card-title">Total de Produtos</h5>
                <h2 class="display-5 fw-bold mb-0">@ViewBag.TotalProdutos</h2>
            </div>
            <div class="card-footer bg-transparent border-0 text-center pb-3">
                <a asp-controller="Produtos" asp-action="Index" class="btn btn-light btn-sm fw-bold w-100">Gerenciar Produtos</a>
            </div>
        </div>
    </div>
    
    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-danger text-white h-100">
            <div class="card-body text-center">
                <h5 class="card-title">Estoque Baixo</h5>
                <h2 class="display-5 fw-bold mb-0">@ViewBag.EstoqueBaixo</h2>
            </div>
            <div class="card-footer bg-transparent border-0 text-center pb-3">
                <a asp-controller="Produtos" asp-action="Index" class="btn btn-light btn-sm fw-bold w-100 text-danger">Ver Alertas</a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-success text-white h-100">
            <div class="card-body text-center">
                <h5 class="card-title">Categorias</h5>
                <h2 class="display-5 fw-bold mb-0">@ViewBag.TotalCategorias</h2>
            </div>
            <div class="card-footer bg-transparent border-0 text-center pb-3">
                <a asp-controller="Categorias" asp-action="Index" class="btn btn-light btn-sm fw-bold w-100 text-success">Ver Categorias</a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-0 bg-info text-white h-100">
            <div class="card-body text-center">
                <h5 class="card-title">Fornecedores</h5>
                <h2 class="display-5 fw-bold mb-0">@ViewBag.TotalFornecedores</h2>
            </div>
            <div class="card-footer bg-transparent border-0 text-center pb-3">
                <a asp-controller="Fornecedores" asp-action="Index" class="btn btn-light btn-sm fw-bold w-100 text-info">Ver Fornecedores</a>
            </div>
        </div>
    </div>
</div>

<div class="row mt-5">
    <div class="col-md-12">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                <h4 class="mb-0 text-secondary"><i class="bi bi-graph-up"></i> Ações Rápidas</h4>
            </div>
            <div class="card-body p-4">
                <div class="d-grid gap-3 d-md-flex justify-content-md-center">
                    <a asp-controller="Movimentacoes" asp-action="Create" class="btn btn-lg btn-outline-primary px-4 rounded-pill">
                        Registrar Movimentação
                    </a>
                    <a asp-controller="Produtos" asp-action="Create" class="btn btn-lg btn-outline-success px-4 rounded-pill">
                        Novo Produto
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
