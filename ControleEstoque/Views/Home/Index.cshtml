@using ControleEstoque.Models
@{
    ViewData["Title"] = "Painel de Controle";
    var cultureBr = new System.Globalization.CultureInfo("pt-BR");
    var totalProdutos = ViewBag.TotalProdutos;
    var estoqueBaixo = ViewBag.EstoqueBaixo;
    var valorCusto = (decimal)ViewBag.ValorTotalCusto;
    var valorVenda = (decimal)ViewBag.ValorTotalVenda;
    var produtosBaixoEstoque = ViewBag.ProdutosEstoqueBaixoList as List<Produto> ?? new List<Produto>();
    var ultimasMovimentacoes = ViewBag.UltimasMovimentacoes as List<MovimentacaoEstoque> ?? new List<MovimentacaoEstoque>();
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="dashboard-title h2 mb-1">Painel de Controle</h1>
            <p class="text-muted mb-0">Visão geral em tempo real do seu estoque e fluxo financeiro.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Movimentacoes" asp-action="Create" class="btn btn-primary-gradient px-4 rounded-pill shadow-sm">
                <i class="bi bi-plus-lg me-2"></i>Registrar Movimentação
            </a>
            <a asp-controller="Produtos" asp-action="Create" class="btn btn-outline-secondary px-4 rounded-pill shadow-sm bg-white">
                <i class="bi bi-box-seam me-2"></i>Novo Produto
            </a>
        </div>
    </div>

    <!-- KPIs Grid -->
    <div class="row g-4 mb-5">
        <!-- Total de Produtos -->
        <div class="col-xl-3 col-md-6">
            <div class="card card-kpi bg-primary text-white h-100">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-white-50 text-uppercase font-weight-bold fs-7">Total de Itens</span>
                        <h3 class="display-6 fw-bold mb-0 mt-1">@totalProdutos</h3>
                    </div>
                    <div class="kpi-icon-container">
                        <i class="bi bi-box-seam-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Alertas de Estoque Baixo -->
        <div class="col-xl-3 col-md-6">
            <div class="card card-kpi @(estoqueBaixo > 0 ? "bg-danger" : "bg-neutral") text-white h-100">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-white-50 text-uppercase font-weight-bold fs-7">Estoque Crítico</span>
                        <h3 class="display-6 fw-bold mb-0 mt-1 d-flex align-items-center gap-2">
                            @estoqueBaixo
                            @if (estoqueBaixo > 0)
                            {
                                <span class="badge bg-white text-danger fs-8 rounded-pill pulse-badge py-1 px-2">Alerta</span>
                            }
                        </h3>
                    </div>
                    <div class="kpi-icon-container">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Custo do Estoque -->
        <div class="col-xl-3 col-md-6">
            <div class="card card-kpi bg-success text-white h-100">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-white-50 text-uppercase font-weight-bold fs-7">Capital Investido</span>
                        <h4 class="fw-bold mb-0 mt-2">@valorCusto.ToString("C2", cultureBr)</h4>
                    </div>
                    <div class="kpi-icon-container">
                        <i class="bi bi-currency-dollar"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Venda Potencial -->
        <div class="col-xl-3 col-md-6">
            <div class="card card-kpi bg-info text-white h-100">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-white-50 text-uppercase font-weight-bold fs-7">Valor de Venda</span>
                        <h4 class="fw-bold mb-0 mt-2">@valorVenda.ToString("C2", cultureBr)</h4>
                    </div>
                    <div class="kpi-icon-container">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="row g-4 mb-5">
        <!-- Gráfico de Categorias -->
        <div class="col-lg-4">
            <div class="card card-glass h-100">
                <div class="card-body p-4">
                    <h5 class="card-title fw-bold mb-3 text-secondary"><i class="bi bi-pie-chart-fill me-2"></i>Por Categoria</h5>
                    <div class="chart-container d-flex justify-content-center align-items-center" style="position: relative; height: 260px;">
                        <canvas id="categoryChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Gráfico de Movimentações -->
        <div class="col-lg-8">
            <div class="card card-glass h-100">
                <div class="card-body p-4">
                    <h5 class="card-title fw-bold mb-3 text-secondary"><i class="bi bi-activity me-2"></i>Fluxo de Movimentações Recentes</h5>
                    <div class="chart-container" style="position: relative; height: 260px;">
                        <canvas id="movementChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Lists Section -->
    <div class="row g-4">
        <!-- Alertas de Estoque Baixo -->
        <div class="col-lg-6">
            <div class="card card-glass h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title fw-bold mb-0 text-secondary"><i class="bi bi-bell-fill me-2 text-danger"></i>Itens Abaixo do Mínimo</h5>
                        <a asp-controller="Produtos" asp-action="Index" class="btn btn-sm btn-outline-danger py-1 px-3 rounded-pill">Ver Todos</a>
                    </div>
                    <div class="table-responsive">
                        @if (produtosBaixoEstoque.Any())
                        {
                            <table class="table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Produto</th>
                                        <th class="text-center">Qtd Atual</th>
                                        <th class="text-center">Mínimo</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var produto in produtosBaixoEstoque)
                                    {
                                        var percent = (double)produto.QuantidadeAtual / Math.Max(1, produto.EstoqueMinimo) * 100;
                                        <tr>
                                            <td class="fw-bold">@produto.Nome</td>
                                            <td class="text-center"><span class="badge bg-danger-subtle text-danger font-weight-bold">@produto.QuantidadeAtual</span></td>
                                            <td class="text-center text-muted">@produto.EstoqueMinimo</td>
                                            <td style="min-width: 120px;">
                                                <div class="progress" style="height: 8px; border-radius: 4px;">
                                                    <div class="progress-bar bg-danger" role="progressbar" style="width: @Math.Min(100, percent)%" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"></div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-check-circle-fill text-success display-6 mb-2 d-block"></i>
                                <span class="text-muted">Excelente! Nenhum produto está com estoque crítico.</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Últimas Movimentações -->
        <div class="col-lg-6">
            <div class="card card-glass h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title fw-bold mb-0 text-secondary"><i class="bi bi-clock-history me-2 text-primary"></i>Últimas Atividades</h5>
                        <a asp-controller="Movimentacoes" asp-action="Index" class="btn btn-sm btn-outline-primary py-1 px-3 rounded-pill">Histórico Completo</a>
                    </div>
                    <div class="table-responsive">
                        @if (ultimasMovimentacoes.Any())
                        {
                            <table class="table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Produto</th>
                                        <th>Tipo</th>
                                        <th class="text-center">Qtd</th>
                                        <th>Data</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var mov in ultimasMovimentacoes)
                                    {
                                        var isEntrada = mov.Tipo == TipoMovimentacao.Entrada;
                                        <tr>
                                            <td class="fw-bold">@(mov.Produto?.Nome ?? "N/A")</td>
                                            <td>
                                                <span class="badge-custom @(isEntrada ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") d-inline-flex align-items-center gap-1">
                                                    <i class="bi @(isEntrada ? "bi-arrow-down-left-circle-fill" : "bi-arrow-up-right-circle-fill")"></i>
                                                    @(isEntrada ? "Entrada" : "Saída")
                                                </span>
                                            </td>
                                            <td class="text-center fw-semibold">@mov.Quantidade</td>
                                            <td class="text-muted fs-8">@mov.DataMovimentacao.ToString("g", cultureBr)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-info-circle text-muted display-6 mb-2 d-block"></i>
                                <span class="text-muted">Nenhuma movimentação registrada no sistema ainda.</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Data serialization from C# to JavaScript
            const categoryData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ProdutosPorCategoria));
            const movementData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.HistoricoMovimentacoes));

            // Setup Category Chart (Doughnut)
            if (categoryData && categoryData.length > 0) {
                const ctxCategory = document.getElementById('categoryChart').getContext('2d');
                new Chart(ctxCategory, {
                    type: 'doughnut',
                    data: {
                        labels: categoryData.map(c => c.Categoria),
                        datasets: [{
                            data: categoryData.map(c => c.Quantidade),
                            backgroundColor: [
                                '#3b82f6', '#10b981', '#f59e0b', '#ef4444', '#06b6d4', '#8b5cf6', '#ec4899', '#6b7280'
                            ],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'right',
                                labels: {
                                    font: { family: 'Outfit', size: 12 },
                                    boxWidth: 12
                                }
                            }
                        },
                        cutout: '65%'
                    }
                });
            } else {
                document.getElementById('categoryChart').parentNode.innerHTML = `<div class="text-muted text-center py-5"><i class="bi bi-bar-chart mb-2 display-6 d-block"></i>Sem dados de categoria para exibir.</div>`;
            }

            // Setup Movement Chart (Bar Chart)
            if (movementData && movementData.length > 0) {
                const ctxMovement = document.getElementById('movementChart').getContext('2d');
                
                // Group by product/date for bar visual representation
                // Reversing to show left-to-right chronologically
                const reversedMovements = [...movementData].reverse();
                
                new Chart(ctxMovement, {
                    type: 'bar',
                    data: {
                        labels: reversedMovements.map(m => m.Produto.substring(0, 15) + (m.Produto.length > 15 ? '...' : '')),
                        datasets: [{
                            label: 'Quantidade Movimentada',
                            data: reversedMovements.map(m => m.Quantidade),
                            backgroundColor: reversedMovements.map(m => m.Tipo === 'Entrada' ? 'rgba(16, 185, 129, 0.85)' : 'rgba(239, 68, 68, 0.85)'),
                            borderColor: reversedMovements.map(m => m.Tipo === 'Entrada' ? '#10b981' : '#ef4444'),
                            borderWidth: 1.5,
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: { color: '#e2e8f0' },
                                ticks: { font: { family: 'Outfit' } }
                            },
                            x: {
                                grid: { display: false },
                                ticks: { font: { family: 'Outfit', size: 10 } }
                            }
                        }
                    }
                });
            } else {
                document.getElementById('movementChart').parentNode.innerHTML = `<div class="text-muted text-center py-5"><i class="bi bi-activity mb-2 display-6 d-block"></i>Sem histórico de movimentações para exibir.</div>`;
            }
        });
    </script>
}
